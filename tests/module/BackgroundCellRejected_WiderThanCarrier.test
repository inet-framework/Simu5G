%description:
A background cell has no more bands than its carrier: it occupies the carrier's first
numResourceBlocks resource blocks, and a CQI of the cell is a what-if on the medium, whose SINRs are
per band of the carrier. A cell with 8 bands on a 6-band carrier is an error at initialization.

The configuration is the default one of a periodic CQI update, with a background UE with traffic
in DL; BackgroundCellRejected_WiderThanCarrierProbabilisticCqi is the same cell with CQIs from a
probability distribution.

%#--------------------------------------------------------------------------------------------------------------
%file: harness.ned
import simu5g.common.binder.Binder;
import simu5g.common.carrierAggregation.CarrierAggregation;
import simu5g.nodes.BackgroundCell;
import simu5g.stack.phy.medium.CellularRadioMedium;

network BackgroundCellRejectedTestNetwork
{
    submodules:
        binder: Binder;
        radioMedium: CellularRadioMedium;
        carrierAggregation: CarrierAggregation;
        bgCell: BackgroundCell;
}
%#--------------------------------------------------------------------------------------------------------------
%inifile: omnetpp.ini
[General]
network = BackgroundCellRejectedTestNetwork

*.carrierAggregation.numComponentCarriers = 1
*.carrierAggregation.componentCarrier[0].carrierFrequency = 2GHz
*.carrierAggregation.componentCarrier[0].numResourceBlocks = 6
*.bgCell.bgScheduler.isNr = true
*.bgCell.bgScheduler.numResourceBlocks = 8
*.bgCell.bgTrafficGenerator.numBgUes = 1
*.bgCell.bgTrafficGenerator.bgUE[0].generator.startTimeDl = 0.1s
*.bgCell.mobility.initialX = 250m
*.bgCell.mobility.initialY = 500m
*.bgCell.bgTrafficGenerator.bgUE[0].mobility.initialX = 500m
*.bgCell.bgTrafficGenerator.bgUE[0].mobility.initialY = 400m

include ../../lib/defaults.ini

%#--------------------------------------------------------------------------------------------------------------
%exitcode: 1
%#--------------------------------------------------------------------------------------------------------------
%contains: stderr
8 resource blocks (numResourceBlocks), but the carrier at 2 GHz has 6
%#--------------------------------------------------------------------------------------------------------------
