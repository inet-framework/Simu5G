%description:
LTE AM in-order delivery (TS 36.322 5.1.3.2): the receiving AM entity reassembles SDUs and
delivers them in sequence to the upper layer. Three consecutive SDUs delivered to PDCP prove
reassembly-and-deliver. Observed at the UE PDCP RX entity (LTE RLC entities are silent).
[CONFORMS]

%file: Lte_Am_Delivery.cc

#include "ProtocolTest.h"
#include "Simu5gRlcTestSupport.h"

namespace inet { namespace protocoltest {
using namespace rlctest;

Define_ProtocolTest(lte_am_delivery)
{
    return ProtocolTest("lte_am_delivery")
        .exactlyTimes(3, on("ue[0].cellularNic.pdcp-rx-1-1")
                  .signal("receivedPacketFromLowerLayer")
                  .describe("an SDU delivered by RLC-AM to PDCP").within(3.0));
}

} } // namespace

%inifile: test.ini
[General]
include ../../ini/_lte.ini
*.tester.testName = "lte_am_delivery"
**.cellularNic.ip2nic.conversationalRlc = "AM"

%contains: stdout
PROTOCOLTEST lte_am_delivery: PASS
