%description:

How a background UE's allocation reaches the radio medium from the eNB
scheduler (LteSchedulerEnb::scheduleGrantBackground() and scheduleBgRtx()),
on a cell with two carriers and in the uplink.

The scheduler allocates on cell-wide band indices: a cell with two carriers of
6 bands has the bands 0 to 11, and the second carrier's are 6 to 11. The medium
keeps a transmission by its carrier, with the bands counted from the carrier's
first one, as a radio's frame has them. So the map the scheduler registers
for a background UE on the second carrier has the blocks of cell band 9 on band
3. (It registered them on band 9, which the carrier does not have: the UE
interfered with nobody.)

In the uplink the scheduler registers the allocation whatever the cell's own
channel model says about uplink interference: which transmissions a receiver
counts is the receiver's decision, as it is for a real UE's frame, which is
always on the medium. So it registers without asking the cell's PHY for a
channel model; the MAC here has no PHY. (It registered a background UE's
uplink only when its own cell had uplinkInterference on.)

%includes:
#include <string>
#include "SchedulerTestUtil.h"
#include "SchedulerHarness.h"
#include "simu5g/background/trafficGenerator/IBackgroundTrafficManager.h"
#include "simu5g/common/cellInfo/CellInfo.h"
#include "simu5g/stack/mac/allocator/LteAllocationModule.h"
#include "simu5g/stack/mac/scheduler/LteSchedulerEnbDl.h"
#include "simu5g/stack/mac/scheduler/LteSchedulerEnbUl.h"

%global:
using namespace simu5g;
using namespace simu5g::unittest;

%activity:
Checker c;
const unsigned int numBands = 6;
const MacNodeId bgUe = MacNodeId(4097);
const GHz carrier1 = GHz(2.0), carrier2 = GHz(3.5);

auto blocksOn = [] (const RbMap& map, Band band) {
    auto antenna = map.find(MACRO);
    if (antenna == map.end())
        return 0u;
    auto it = antenna->second.find(band);
    return it == antenna->second.end() ? 0u : it->second;
};

// downlink, on cell band 9: band 3 of the second carrier
auto checkSecondCarrier = [&] (const std::string& what, TestEnbMac *mac, unsigned int allocatedBytes) {
    RecordingBgManager& m = mac->manager;
    c.check(what + ": the allocation is made and registered once", allocatedBytes > 0 && m.registrations == 1,
            std::to_string(allocatedBytes) + " bytes, " + std::to_string(m.registrations) + " registrations");
    c.check(what + ": the blocks of cell band 9 are registered on band 3 of the second carrier", blocksOn(m.registered, Band(3)) > 0,
            std::to_string(blocksOn(m.registered, Band(3))) + " blocks on band 3");
    c.check(what + ": ...and none on band 9, which the carrier does not have", blocksOn(m.registered, Band(9)) == 0,
            std::to_string(blocksOn(m.registered, Band(9))) + " blocks on band 9");
};

{
    TestEnbMac *mac = new TestEnbMac({carrier1, carrier2}, numBands);
    auto *scheduler = new TestScheduler<LteSchedulerEnbDl>();
    scheduler->setup(mac, DL, 2 * numBands);
    BandLimitVector bandLim = { BandLimit(Band(9)) };
    bool terminate = false, active = true, eligible = true;
    unsigned int bytes = scheduler->scheduleGrantBackground(MacCid(bgUe, LogicalCid(0)), 1000, terminate, active, eligible, carrier2, &bandLim);
    checkSecondCarrier("DL new data", mac, bytes);
    delete scheduler;
    delete mac;
}

{
    TestEnbMac *mac = new TestEnbMac({carrier1, carrier2}, numBands);
    auto *scheduler = new TestScheduler<LteSchedulerEnbDl>();
    scheduler->setup(mac, DL, 2 * numBands);
    BandLimitVector bandLim = { BandLimit(Band(9)) };
    unsigned int bytes = scheduler->scheduleBgRtx(bgUe, carrier2, Codeword(0), &bandLim);
    checkSecondCarrier("DL retransmission", mac, bytes);
    delete scheduler;
    delete mac;
}

// uplink, on a MAC without a PHY: registered without asking for the cell's channel model
{
    TestEnbMac *mac = new TestEnbMac({carrier1}, numBands);
    auto *scheduler = new TestScheduler<LteSchedulerEnbUl>();
    scheduler->setup(mac, UL, numBands);
    BandLimitVector bandLim = { BandLimit(Band(3)) };
    bool terminate = false, active = true, eligible = true;
    unsigned int bytes = scheduler->scheduleGrantBackground(MacCid(bgUe, LogicalCid(0)), 1000, terminate, active, eligible, carrier1, &bandLim);
    c.check("UL new data: the allocation is made and registered once", bytes > 0 && mac->manager.registrations == 1,
            std::to_string(bytes) + " bytes, " + std::to_string(mac->manager.registrations) + " registrations");
    delete scheduler;
    delete mac;
}

{
    TestEnbMac *mac = new TestEnbMac({carrier1}, numBands);
    auto *scheduler = new TestScheduler<LteSchedulerEnbUl>();
    scheduler->setup(mac, UL, numBands);
    BandLimitVector bandLim = { BandLimit(Band(3)) };
    unsigned int bytes = scheduler->scheduleBgRtx(bgUe, carrier1, Codeword(0), &bandLim);
    c.check("UL retransmission: the allocation is made and registered once", bytes > 0 && mac->manager.registrations == 1,
            std::to_string(bytes) + " bytes, " + std::to_string(mac->manager.registrations) + " registrations");
    delete scheduler;
    delete mac;
}

c.summary();

%contains: stdout
modelchecks=8 modelfailures=0

%not-contains: stdout
FAILED
