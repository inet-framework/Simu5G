%description:

A link's propagation conditions are the same on every carrier; its fast
fading is not.

TR 38.901 7.6.5, on simulations with several frequencies: "Propagation
conditions generated in Step 2 are the same for all the frequencies" (the
LOS state, and with it the effective environment height of Table 7.4.1-1
NOTE 1), "The parameters generated in Step 4 are the same for all the
frequencies" (the shadow fading is one of them), and "Steps 8-11 are
independently applied for the frequency bands" (the fast fading).

Checked with two channel models on two carriers evaluating the same
downlink. The radio medium keeps one LOS table and one shadowing table for
all carriers, and one table of Jakes paths per carrier. The first carrier's
evaluation draws the link's LOS state and shadowing; the second carrier's
takes them and draws only its own Jakes paths. The path loss with shadowing
of the two carriers then differs by the difference of their closed-form path
losses in that one LOS state, and by nothing else.

%includes:
#include "SchedulerTestUtil.h"
#include "ChannelModelTestUtil.h"

%global:
using namespace simu5g;
using namespace simu5g::unittest;

%file: harness.ned
import simu5g.common.binder.Binder;
import simu5g.stack.phy.medium.CellularRadioMedium;
import simu5g.common.carrierAggregation.CarrierAggregation;
import simu5g.stack.phy.channelmodel.Tr38901ChannelModel;

network Harness
{
    submodules:
        binder: Binder;
        radioMedium: CellularRadioMedium;
        carrierAggregation: CarrierAggregation;
        modelA: Tr38901ChannelModel;
        modelB: Tr38901ChannelModel;
        test: Test;
}

%inifile: omnetpp.ini
[General]
network = Harness
cmdenv-express-mode = false
cmdenv-log-prefix = ""
sim-time-limit = 1s

*.carrierAggregation.numComponentCarriers = 2
*.carrierAggregation.componentCarrier[0].carrierFrequency = 2GHz
*.carrierAggregation.componentCarrier[0].numResourceBlocks = 10
*.carrierAggregation.componentCarrier[1].carrierFrequency = 3.5GHz
*.carrierAggregation.componentCarrier[1].numResourceBlocks = 10
*.modelA.componentCarrierModule = "carrierAggregation.componentCarrier[0]"
*.modelB.componentCarrierModule = "carrierAggregation.componentCarrier[1]"
**.cellInfoModule = ""
*.binder.printTrafficGeneratorConfig = false

# Every per-link ingredient on, so that each one has state to keep.
**.dynamicLos = true
**.shadowing = true
**.fading = true
**.fadingType = "JAKES"

%no-default-inifile: 1

%activity:
Checker c;
auto *modelA = harnessModule<StochasticChannelModel>(this, "modelA");
auto *modelB = harnessModule<StochasticChannelModel>(this, "modelB");
auto *medium = harnessModule<CellularRadioMedium>(this, "radioMedium");

StubEndpoint bsEndpoint, ueEndpoint;
const MacNodeId bsId = MacNodeId(1), ueId = MacNodeId(1025);
bsEndpoint.nodeId = bsId;
ueEndpoint.nodeId = ueId;
bsEndpoint.coord = inet::Coord(0, 0, 25);
ueEndpoint.coord = inet::Coord(120, 45, 1.5);
bsEndpoint.txPower = 40.0;
ueEndpoint.txPower = 23.0;
StubRadioRegistration bsRadio(medium, bsId, &bsEndpoint);
StubRadioRegistration ueRadio(medium, ueId, &ueEndpoint);
ChannelModelProbe probeA(modelA), probeB(modelB);
const LinkKey link(bsId, ueId);
auto drawn = [](StochasticChannelModel *model) { return (long long)model->getRNG(0)->getNumbersDrawn(); };

c.check("the two models are on two carriers", modelA->getCarrierFrequency() != modelB->getCarrierFrequency());
c.check("the carriers share one LOS table and one shadowing table",
        &probeA.losMap() == &probeB.losMap() && &probeA.shadowingMap() == &probeB.shadowingMap());
c.check("each carrier has its own table of Jakes paths", &probeA.jakesMap() != &probeB.jakesMap());

// Away from t = 0, as for every Jakes evaluation.
wait(0.010);

// A DL CQI of the same link, at the base station, on each carrier.
long long before = drawn(modelA);
modelA->getRSRP(probeA.whatIfLink(&ueEndpoint, dlCqiTransmission(&bsEndpoint, ueId)), 30.0);
long long firstCarrierDraws = drawn(modelA) - before;
c.check("an evaluation on the first carrier decides the link's LOS state and shadowing, and that carrier's Jakes paths",
        probeA.losMap().count(link) == 1 && probeA.shadowingMap().count(link) == 1 && probeA.jakesMap().count(link) == 1);
c.check("...and none of the other carrier's Jakes paths", probeB.jakesMap().count(link) == 0);
const bool los = probeA.losMap().at(link).los;
const double environmentHeight = probeA.losMap().at(link).environmentHeight;
const double shadowing = probeA.shadowingMap().at(link).value;

// The second carrier takes the LOS state and the shadowing, and draws its own Jakes paths.
before = drawn(modelB);
modelB->getRSRP(probeB.whatIfLink(&ueEndpoint, dlCqiTransmission(&bsEndpoint, ueId)), 30.0);
long long secondCarrierDraws = drawn(modelB) - before;
before = drawn(modelB);
modelB->getRSRP(probeB.whatIfLink(&ueEndpoint, dlCqiTransmission(&bsEndpoint, ueId)), 30.0);
long long repeatDraws = drawn(modelB) - before;
c.check("the second carrier keeps the link's LOS state and environment height",
        probeB.losMap().size() == 1 && probeB.losMap().at(link).los == los && probeB.losMap().at(link).environmentHeight == environmentHeight);
c.check("...and its shadowing", probeB.shadowingMap().size() == 1 && probeB.shadowingMap().at(link).value == shadowing);
c.check("...and draws Jakes paths of its own, and nothing else",
        probeB.jakesMap().count(link) == 1 && secondCarrierDraws > repeatDraws && secondCarrierDraws < firstCarrierDraws,
        "first carrier=" + std::to_string(firstCarrierDraws) + " second=" + std::to_string(secondCarrierDraws) + " repeat=" + std::to_string(repeatDraws));

// The path loss with shadowing: the carriers differ by their closed forms in the one LOS state.
{
    RadioLink linkA = probeA.whatIfLink(&ueEndpoint, dlCqiTransmission(&bsEndpoint, ueId));
    RadioLink linkB = probeB.whatIfLink(&ueEndpoint, dlCqiTransmission(&bsEndpoint, ueId));
    const double d3D = bsEndpoint.coord.distance(ueEndpoint.coord);
    const double d2D = sqrt(pow(bsEndpoint.coord.x - ueEndpoint.coord.x, 2) + pow(bsEndpoint.coord.y - ueEndpoint.coord.y, 2));
    PathLossModel::LinkConditions conditions;
    conditions.environmentHeight = environmentHeight;
    double closedFormA = probeA.pathLoss()->computePathLoss(probeA.deployment(25, 1.5), d3D, d2D, los, conditions);
    double closedFormB = probeB.pathLoss()->computePathLoss(probeB.deployment(25, 1.5), d3D, d2D, los, conditions);
    c.expectNear("the first carrier's attenuation is its closed form and the link's shadowing",
            modelA->getAttenuation(linkA), closedFormA + shadowing, 1e-9);
    c.expectNear("the second carrier's attenuation is its closed form and the same shadowing",
            modelB->getAttenuation(linkB), closedFormB + shadowing, 1e-9);
}

c.summary();

%contains: stdout
modelchecks=10 modelfailures=0

%not-contains: stdout
FAILED
