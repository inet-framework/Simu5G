%description:

The azimuth that places a UE in a sectorial antenna pattern is the horizontal
angle between the antenna's reference axis and the UE, whatever the heights of
the two ends: the vertical angle is computed separately by
computeVerticalAngle(), and the two are passed to the antenna pattern as
independent arguments, as TR 38.901 7.3 defines it.

A UE due north of a 25 m mast, 50 m away at 1.5 m, is at 90 degrees. (The
azimuth was asin(dy / d) with d the three-dimensional distance, so the height
difference pulled the result towards the x axis: about 65 degrees here, and a
sectorial antenna's attenuation was evaluated 25 degrees off.) All four
quadrants are checked with a height difference, and a point straight above or
below the antenna, where no direction is defined, is at azimuth 0 and not
"not a number": co-located sectors ask for it.

%includes:
#include "SchedulerTestUtil.h"
#include "ChannelModelTestUtil.h"

%global:
using namespace simu5g;
using namespace simu5g::unittest;
using inet::Coord;

%file: harness.ned
import simu5g.common.binder.Binder;
import simu5g.stack.phy.medium.CellularRadioMedium;
import simu5g.common.carrierAggregation.CarrierAggregation;
import simu5g.stack.phy.channelmodel.Tr38901ChannelModel;

network Harness
{
    submodules:
        binder: Binder;
        radioMedium: CellularRadioMedium;
        carrierAggregation: CarrierAggregation;
        bsChannelModel: Tr38901ChannelModel;
        test: Test;
}

%inifile: omnetpp.ini
[General]
network = Harness
cmdenv-express-mode = false
cmdenv-log-prefix = ""
sim-time-limit = 1s
*.carrierAggregation.numComponentCarriers = 1
*.carrierAggregation.componentCarrier[0].carrierFrequency = 3.5GHz
*.carrierAggregation.componentCarrier[0].numBands = 10
**.cellInfoModule = ""
*.binder.printTrafficGeneratorConfig = false

%no-default-inifile: 1

%activity:
Checker c;
auto *m = harnessModule<StochasticChannelModel>(this, "bsChannelModel");

const Coord mast(0, 0, 25);
c.expectNear("a UE due north of a mast is at azimuth 90, whatever the heights",
        m->computeAngle(mast, Coord(0, 50, 1.5)), 90, 1e-9);
c.expectNear("a UE at 45 degrees is at azimuth 45, whatever the heights",
        m->computeAngle(mast, Coord(50, 50, 1.5)), 45, 1e-9);

c.expectNear("...and at 135 degrees in the second quadrant",
        m->computeAngle(mast, Coord(-50, 50, 1.5)), 135, 1e-9);
c.expectNear("...at 225 degrees in the third",
        m->computeAngle(mast, Coord(-50, -50, 1.5)), 225, 1e-9);
c.expectNear("...and at 315 degrees in the fourth",
        m->computeAngle(mast, Coord(50, -50, 1.5)), 315, 1e-9);
c.expectNear("a point straight below the antenna is at azimuth 0",
        m->computeAngle(mast, Coord(0, 0, 1.5)), 0, 1e-9);

c.summary();

%contains: stdout
modelchecks=6 modelfailures=0

%not-contains: stdout
FAILED
