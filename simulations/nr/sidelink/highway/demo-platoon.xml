<config>
    <!-- all sidelink UEs participate in the broadcast CAM group -->
    <multicast-group hosts="ue[*]" interfaces="cellular" address="224.0.0.10"/>
    <!-- the platoon members additionally form their own groupcast group -->
    <multicast-group hosts="ue[0] ue[1] ue[2] ue[3] ue[4]" interfaces="cellular" address="224.0.0.20"/>
    <interface hosts='*' address='192.168.x.x' netmask='255.255.0.0'/>
</config>
